# Don't apply this file directly. Create the secret like this instead:
#
# Generate a GitHub Personal Access Token (classic) with `read:packages` scope at:
#   https://github.com/settings/tokens
#
# Then:
#   kubectl create secret docker-registry ghcr-pull \
#     --docker-server=ghcr.io \
#     --docker-username=YOUR_GH_USERNAME \
#     --docker-password=YOUR_PAT \
#     --docker-email=you@example.com \
#     -n miaya-playbook
#
# Or via fine-grained tokens, scope = "Read packages" on the specific repo.
