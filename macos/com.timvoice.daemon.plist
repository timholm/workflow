<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.timvoice.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>daemon.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>~/workflow/macos</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>~/Library/Logs/timvoice-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>~/Library/Logs/timvoice-daemon-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TIMVOICE_SERVER</key>
        <string>http://localhost:8080</string>
    </dict>
</dict>
</plist>
